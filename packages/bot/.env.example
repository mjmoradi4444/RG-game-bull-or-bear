# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
BOT_TOKEN=
GAME_SHORT_NAME=bull_or_bear
GAME_URL=https://your-frontend-host.example
SCORE_SECRET=
PORT=8080
ALLOW_ORIGIN=*

# Admin dashboard (PRD-ADMIN-EMAIL). The /admin panel is DISABLED until BOTH
# ADMIN_USER and ADMIN_PASSWORD_HASH are set. Generate the hash (never store the
# plaintext password anywhere) with:  npm run admin:hash -- 'your-strong-password'
ADMIN_USER=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Optional hardening / integration:
ADMIN_IP_ALLOWLIST=
REBATEGAIN_BACKOFFICE_URL=
